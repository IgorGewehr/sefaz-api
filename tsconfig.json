{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "@app/fiscal-core": ["libs/fiscal-core/src"],
      "@app/fiscal-core/*": ["libs/fiscal-core/src/*"],
      "@app/sefaz": ["libs/sefaz/src"],
      "@app/sefaz/*": ["libs/sefaz/src/*"],
      "@app/database": ["libs/database/src"],
      "@app/database/*": ["libs/database/src/*"],
      "@app/storage": ["libs/storage/src"],
      "@app/storage/*": ["libs/storage/src/*"],
      "@app/kms": ["libs/kms/src"],
      "@app/kms/*": ["libs/kms/src/*"],
      "@app/crypto": ["libs/crypto/src"],
      "@app/crypto/*": ["libs/crypto/src/*"],
      "@app/common": ["libs/common/src"],
      "@app/common/*": ["libs/common/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "legacy", "scripts", "test-validation.ts", "test-svrs.mjs"]
}
