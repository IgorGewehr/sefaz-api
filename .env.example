# ===========================================================================
# SEFAZ API - Environment Variables
# ===========================================================================

# =====================================================
# Server Configuration
# =====================================================

# Server port
PORT=3333

# Node environment
NODE_ENV=development

# API base URL
API_URL=http://localhost:3001

# =====================================================
# SEFAZ Configuration
# =====================================================

# Environment: producao | homologacao
SEFAZ_AMBIENTE=homologacao

# =====================================================
# Authentication
# =====================================================

# API keys for client authentication (Bearer token em Authorization header).
# Use API_KEY (uma chave) OU API_KEYS (várias, separadas por vírgula).
# API_KEYS permite rotação sem downtime: adicione a nova chave, migre clientes,
# depois remova a antiga. Pelo menos uma é obrigatória.
# Generate with: openssl rand -hex 32
API_KEY=
# API_KEYS=key1,key2,key3

# Admin key — required by destructive endpoints (e.g. POST /api/metrics/reset).
# If unset, admin endpoints return 403 (disabled). Header expected: X-Admin-Key
# Generate with: openssl rand -hex 32
ADMIN_KEY=

# Validar que o CNPJ do certificado A1 bate com o CNPJ do emitente/prestador
# informado no payload (prevenção de uso cruzado de certificados).
# Default: true. Defina como "false" para desabilitar em ambientes específicos.
VALIDATE_CERT_CNPJ=true

# =====================================================
# Responsável Técnico (NT 2018.005) — obrigatório
# =====================================================
# Todos os documentos NFe/NFCe carregam o bloco <infRespTec> com os dados
# da empresa que mantém o software emissor. Sem estas variáveis a API não sobe.
RESP_TEC_CNPJ=
RESP_TEC_CONTATO=
RESP_TEC_EMAIL=
RESP_TEC_FONE=

# =====================================================
# Logging Configuration
# =====================================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Log output: console | file
LOG_OUTPUT=console

# Log file path (only used if LOG_OUTPUT=file)
# Ensure the directory exists and is writable
LOG_FILE_PATH=/var/log/sefaz-api/app.log

# Maximum log file size in bytes (default: 10MB)
# When exceeded, file is rotated with timestamp
LOG_MAX_SIZE=10485760

# =====================================================
# Performance & Caching
# =====================================================

# Certificate cache TTL in milliseconds (default: 30 minutes)
CERT_CACHE_TTL_MS=1800000

# HTTPS Agent cache TTL in milliseconds (default: 8 hours)
AGENT_CACHE_TTL_MS=28800000

# Request timeout in milliseconds (default: 60 seconds)
REQUEST_TIMEOUT_MS=60000

# Max retry attempts for failed requests
MAX_RETRY_ATTEMPTS=3

# =====================================================
# Rate Limiting (optional)
# =====================================================

# Rate limit per IP + Authorization header (sempre ativo)
RATE_LIMIT_MAX=60

# Window duration in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Upper bound on cached parsed PFX certificates (evita memory leak multi-tenant)
CERT_CACHE_MAX=200

# Upper bound on cached https.Agents (cada agent mantém keep-alive)
AGENT_CACHE_MAX=200

# =====================================================
# Circuit Breaker SEFAZ
# =====================================================
# Falha rápido quando um endpoint SEFAZ fica instável em vez de enfileirar
# requests de 60s de timeout. Só conta timeouts / 5xx como falha de infra
# (4xx é erro de payload e não abre circuito).
CIRCUIT_BREAKER_ENABLED=true
# N de falhas consecutivas dentro da janela pra abrir o circuito
CIRCUIT_BREAKER_THRESHOLD=5
# Janela de contagem de falhas (ms)
CIRCUIT_BREAKER_WINDOW_MS=30000
# Tempo que o circuito fica aberto antes de tentar meio-aberto (ms)
CIRCUIT_BREAKER_COOLDOWN_MS=15000

# Redis URL for distributed rate limiting (optional)
# REDIS_URL=redis://localhost:6379

# =====================================================
# Monitoring (optional)
# =====================================================

# Sentry DSN (error tracking)
# SENTRY_DSN=https://xxx@sentry.io/yyy

# Prometheus metrics endpoint
METRICS_ENABLED=false

# =====================================================
# CORS Configuration
# =====================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =====================================================
# Security
# =====================================================================

# Enable helmet security headers
HELMET_ENABLED=true

# Enable HTTPS redirect (production only)
FORCE_HTTPS=false
