# ===========================================================================
# SEFAZ API v2 — SaaS Fiscal Engine
# ===========================================================================

# --- Server ---
NODE_ENV=development
PORT=3333
WORKER_PORT=3334
API_URL=http://localhost:3333

# --- Database (Postgres + Prisma) ---
DATABASE_URL=postgresql://sefaz:sefaz@localhost:5432/sefaz?schema=public

# --- Redis (BullMQ + cache) ---
REDIS_URL=redis://localhost:6379

# --- KMS ---
# Provider: local | aws | gcp
KMS_PROVIDER=local
# When local: 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
KMS_LOCAL_MASTER_KEY=
# When aws/gcp:
KMS_KEY_ID=
KMS_REGION=sa-east-1

# --- Storage (XML, DANFE, SPED) ---
# Provider: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.storage
# When s3:
S3_BUCKET=
S3_REGION=sa-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Multi-tenancy ---
# Bootstrap admin tenant (created by seed)
ADMIN_TENANT_NAME=Sefaz API Admin
ADMIN_TENANT_EMAIL=admin@example.com

# --- SEFAZ ---
# Default environment if tenant has none configured: producao | homologacao
SEFAZ_DEFAULT_AMBIENTE=homologacao
# Validate cert CNPJ matches emitter CNPJ
VALIDATE_CERT_CNPJ=true

# --- Responsável Técnico (NT 2018.005) — required to emit NFe/NFCe ---
RESP_TEC_CNPJ=
RESP_TEC_CONTATO=
RESP_TEC_EMAIL=
RESP_TEC_FONE=

# --- Circuit Breaker SEFAZ ---
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_MS=30000
CIRCUIT_BREAKER_COOLDOWN_MS=15000

# --- Logging ---
LOG_LEVEL=info

# --- Throttling ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Webhooks ---
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_MS=10000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Security ---
HELMET_ENABLED=true
SWAGGER_ENABLED=true
